# Django Settings Module
DJANGO_SETTINGS_MODULE=volta.settings.production

# Security
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY
DEBUG=False

# Allowed Hosts (replace with your EC2 public IP)
ALLOWED_HOSTS=REPLACE_WITH_EC2_IP,localhost,127.0.0.1

# CORS Origins (replace with your EC2 public IP)
CORS_ALLOWED_ORIGINS=http://REPLACE_WITH_EC2_IP

# Database Configuration
DATABASE_URL=postgresql://volta_user:REPLACE_WITH_DB_PASSWORD@db:5432/volta

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=amqp://volta:REPLACE_WITH_RABBITMQ_PASSWORD@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Admin User (created automatically on first run)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@volta.app
DJANGO_SUPERUSER_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# File Upload Settings
MAX_UPLOAD_SIZE=104857600

# Security Settings (HTTP deployment - change for HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Logging
LOG_LEVEL=INFO

# Deployment Environment
DEPLOYMENT_ENV=production
