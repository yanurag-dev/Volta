# ==========================================
# Volta Production Environment - AWS Setup
# ==========================================
# This file uses AWS managed services:
# - RDS PostgreSQL
# - ElastiCache Redis/Valkey
# - CloudAMQP RabbitMQ
# ==========================================

# Django Settings
DJANGO_SETTINGS_MODULE=volta.settings.production

# Security
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY
DEBUG=False

# Allowed Hosts (add your EC2 public IP)
ALLOWED_HOSTS=YOUR_EC2_PUBLIC_IP,localhost,127.0.0.1

# CORS Origins (add your EC2 public IP)
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# ==========================================
# AWS RDS PostgreSQL Configuration
# ==========================================
# Get from: AWS Console → RDS → Databases → volta-db
# Format: postgresql://username:password@endpoint:port/database
DATABASE_URL=postgresql://postgres:YOUR_RDS_PASSWORD@YOUR_RDS_ENDPOINT:5432/volta

# Example:
# DATABASE_URL=postgresql://postgres:MySecurePass123@volta-db.abc123.ap-southeast-2.rds.amazonaws.com:5432/volta

# ==========================================
# AWS ElastiCache Redis/Valkey Configuration
# ==========================================
# Get from: AWS Console → ElastiCache → Redis caches → volta-redis
# Format: redis://endpoint:port/0
REDIS_URL=redis://YOUR_REDIS_ENDPOINT:6379/0

# Example:
# REDIS_URL=redis://volta-redis.abc123.cache.amazonaws.com:6379/0

# ==========================================
# CloudAMQP RabbitMQ Configuration
# ==========================================
# Get from: CloudAMQP Dashboard → volta-rabbitmq → AMQP URL
# Format: amqps://username:password@host/vhost
CELERY_BROKER_URL=YOUR_CLOUDAMQP_URL

# Example:
# CELERY_BROKER_URL=amqps://xvjpxkcd:abc123xyz@kangaroo.rmq.cloudamqp.com/xvjpxkcd

# Celery Result Backend (uses Redis)
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TASK_ALWAYS_EAGER=False

# ==========================================
# Admin User (auto-created on first run)
# ==========================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@volta.app
DJANGO_SUPERUSER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ==========================================
# File Upload Settings
# ==========================================
MAX_UPLOAD_SIZE=104857600

# ==========================================
# Security Settings (HTTP deployment)
# ==========================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO

# ==========================================
# Deployment Environment
# ==========================================
DEPLOYMENT_ENV=production
DEPLOYMENT_PLATFORM=aws-ec2
