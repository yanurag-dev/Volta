# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql://volta_user:volta_password@db:5432/volta

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
CELERY_BROKER_URL=amqp://volta:volta_password@rabbitmq:5672//

# File Upload
MAX_UPLOAD_SIZE=104857600

# Celery
CELERY_TASK_ALWAYS_EAGER=False

# CSV Processing Configuration
# These settings control batch processing performance for large CSV uploads
CSV_CHUNK_SIZE=50000              # Products per chunk (larger = faster, more memory)
CSV_BATCH_SIZE=5000               # Products per database batch operation
CSV_PROGRESS_INTERVAL=10000       # Update progress every N products
CSV_READING_PROGRESS_INTERVAL=50000  # Update progress during reading every N rows

# Celery Worker Configuration
CELERY_WORKER_CONCURRENCY=8       # Number of parallel worker processes
CELERY_WORKER_PREFETCH_MULTIPLIER=1  # Tasks to prefetch per worker
